<%- include ('partials/header.ejs') %>

<% if (messages.danger) { %>
    <div class="alert alert-danger flash-message alert-dismissible fase show">
        <button class="btn-close" data-bs-dismiss="alert"></button>
            <%= messages.danger %>
    </div>
<% } %>

<% if (messages.success) { %>
    <div class="alert alert-success flash-message alert-dismissible fase show">
        <button class="btn-close" data-bs-dismiss="alert"></button>
            <%= messages.success %>
    </div>
<% } %>
    <main>
        <div class="card">
            <div class="header-card">
                <div class="img-logo">
                    <img src="/imgs/Logo-Vetorizada.png" alt="Logo do sistema Guster">
                </div>
                <h3>Realizar Login</h3>
            </div>

            <form class="body-card" action="/login/medico" method="post">
                <div class="field">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" placeholder="exemplo@gmail.com" required>
                </div>

                <div class="field">
                    <label for="senha">Senha</label>

                    <div class="campo-senha">
                        <input type="password" id="senha" name="senha" placeholder="************" required>

                        <button type="button" class="btn-olho" data-alternar-senha="senha" aria-label="Mostrar senha" aria-pressed="false">
                            <svg class="icone-visivel" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="icone-escondido" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <path d="M1 1l22 22"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <path d="M10 17l5-5-5-5"/>
                        <path d="M15 12H3"/>
                    </svg>
                    Acessar Plataforma
                </button>

                <p class="signup">Primeiro acesso? <a href="/cadastro">Cadastre-se</a></p>
            </form>
        </div>
    </main>

<script src="/js/mostrarSenha.js"></script>
<%- include ('partials/footer.ejs') %>
