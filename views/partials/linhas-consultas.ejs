<% exames.forEach(function (c) { %>
<tr>
    <td>
        <div class="paciente">
            <div class="paciente-avatar">
                <img src="<%= c.Paciente.foto %>" alt="Foto do paciente">
            </div>
            <div>
                <strong><%= c.Paciente.nome %></strong>
                <span><%= c.Paciente.idade %> anos - Prontuário #<%= c.Paciente.id %></span>
            </div>
        </div>
    </td>
    <td>
        <div class="consulta-data">
            <strong><%= c.data_realizacao %></strong>
            <span>Sessão n° <%= c.id %></span>
        </div>
    </td>
    <td class="centro"><span class="tag tag-verde"><%= c.status_exame %></span></td>
    <td class="centro"><span class="tag tag-<%= c.Processamentos[0]?.resultado.toLowerCase() %>"><%= c.Processamentos[0]?.resultado %></span></td>
    <td class="centro">
        <div class="acoes">
            <a href="/consulta/resultado?id_processamento=<%= c.Processamentos[0]?.id %>" class="btn-acao">Abrir Laudo</a>
            <% if (arquivadas) { %>
                <form action="/consultas/<%= c.id %>/desarquivar" method="post">
                    <button type="submit" class="btn-acao" style="color: #FF3F3F;">Desarquivar</button>
                </form>
            <% } else { %>
                <form action="/consultas/<%= c.id %>/arquivar" method="post">
                    <button type="submit" class="btn-acao">Arquivar</button>
                </form>
            <% } %>
        </div>
    </td>
</tr>
<% }); %>
<% if (!exames.length) { %>
<tr><td colspan="5" class="centro">Nenhuma consulta encontrada.</td></tr>
<% } %>