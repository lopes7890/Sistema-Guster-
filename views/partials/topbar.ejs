<header class="topbar">
    <div class="topbar-titulo">
        <h1>Olá Dr. <%= medico.nome.split(" ")[0] %></h1>
        <p>Painel Central</p>
    </div>

    <div class="topbar-direita">
        <div class="topbar-usuario">
            <div class="topbar-avatar"></div>
            <div class="topbar-dados">
                <strong><%= medico.nome.split(" ")[0] %></strong>
                <small>CRM: <%= medico.crm %></small>
            </div>
        </div>

        <% if (locals.mostrarNovaConsulta) { %>
            <span class="topbar-divisor"></span>
            <a href="/consulta/nova" class="btn-nova-consulta">+ Nova Consulta</a>
        <% } %>
    </div>
</header>
