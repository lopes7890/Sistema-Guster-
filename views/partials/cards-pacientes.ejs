<% if (lista.length === 0) { %>
    <p class="pacientes-vazio">
        <%= arquivados ? 'Nenhum paciente arquivado encontrado.' : 'Nenhum paciente encontrado.' %>
    </p>
<% } %>

<% lista.forEach(function (p) { %>
    <% const exame = p.Exames?.[0]; %>
    <% const processamento = exame?.Processamentos?.[0]; %>

    <article class="card-paciente">
        <% if (arquivados) { %>
        <a href="/paciente/<%= p.id %>/deletar" class="card-paciente-lixeira" aria-label="Excluir paciente <%= p.nome %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 6h18"/>
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                <path d="M10 11v6"/>
                <path d="M14 11v6"/>
                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            </svg>
        </a>
        <% } %>

        <div class="card-paciente-topo">
            <div class="card-paciente-avatar">
                <% if (p.foto) { %>
                    <img src="<%= p.foto %>" alt="Foto de <%= p.nome %>">
                <% } %>
            </div>

            <div class="card-paciente-dados">
                <strong>Nome:</strong>
                <span><%= p.nome %></span>

                <strong class="espaco">Data do último exame:</strong>
                <span><%= exame?.data_realizacao_formatada || '—' %></span>
            </div>
        </div>

        <div class="card-paciente-acoes">
            <% if (processamento) { %>
                <a href="/consulta/resultado?id_processamento=<%= processamento.id %>" class="btn-card btn-visualizar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Visualizar Prontuário
                </a>
            <% } else { %>
                <span>Sem processamento disponível</span>
            <% } %>

            <% if (arquivados) { %>
                <form action="/pacientes/<%= p.id %>/desarquivar" method="post">
                    <button type="submit" class="btn-card btn-desarquivar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 21h18"/>
                            <path d="M12 17V3"/>
                            <polyline points="5 10 12 3 19 10"/>
                        </svg>
                        Desarquivar Prontuário
                    </button>
                </form>
            <% } else { %>
                <form action="/pacientes/<%= p.id %>/arquivar" method="post">
                    <button type="submit" class="btn-card btn-arquivar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 6h18"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6"/>
                            <path d="M14 11v6"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                        Arquivar Prontuário
                    </button>
                </form>
            <% } %>
        </div>
    </article>
<% }); %>