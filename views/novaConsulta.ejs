<%- include ('partials/header.ejs') %>
    <div class="layout">
        <%- include ('partials/sidebar.ejs', { paginaAtiva: 'home' }) %>

        <div class="layout-conteudo">
            <%- include ('partials/topbar.ejs') %>

            <main class="paciente-novo">
                <section class="paciente-novo-card">
                    <h2>Cadastrar paciente</h2>

                    <%- include ('partials/stepper.ejs', { etapaAtual: 1 }) %>

                    <form class="form-paciente" action="/pacientes/novo" method="post" enctype="multipart/form-data">
                        <div class="campos">
                            <div class="field">
                                <label for="nome">Nome Completo</label>
                                <input type="text" id="nome" name="nome" placeholder="Fulano Souza" autocomplete="off" required>
                            </div>

                            <div class="linha linha-3">
                                <div class="field">
                                    <label for="nascimento">Data de Nascimento</label>
                                    <input type="date" id="nascimento" name="nascimento" required>
                                </div>

                                <div class="field">
                                    <label for="telefone">Telefone</label>
                                    <input type="tel" id="telefone" name="telefone" data-mascara="telefone" placeholder="(12)99999-4567" autocomplete="off" required>
                                </div>

                                <div class="field">
                                    <label for="cpf">CPF</label>
                                    <input type="text" id="cpf" name="cpf" data-mascara="cpf" placeholder="XXX.XXX.XXX-XX" inputmode="numeric" maxlength="14" pattern="\d{3}\.\d{3}\.\d{3}-\d{2}" title="Formato: 000.000.000-00" autocomplete="off" required>
                                </div>
                            </div>

                            <div class="linha linha-2">
                                <div class="field">
                                    <label for="endereco">Endereço</label>
                                    <input type="text" id="endereco" name="endereco" placeholder="Rua 123 N° 145 - São Paulo/SP" autocomplete="off" required>
                                </div>

                                <div class="field">
                                    <label for="cep">CEP</label>
                                    <input type="text" id="cep" name="cep" data-mascara="cep" placeholder="XXXXX-XXX" inputmode="numeric" maxlength="9" pattern="\d{5}-\d{3}" title="Formato: 00000-000" autocomplete="postal-code" required>
                                </div>
                            </div>

                            <div class="field">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="fulano123@gmail.com" autocomplete="off" required>
                            </div>

                            <!-- Foto opcional do paciente -->
                            <div class="anexo-foto">
                                <input type="file" id="foto" name="foto" accept="image/*">
                                <label for="foto">
                                    <svg width="40" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14.5 6h-5L7.5 8.5H4a2 2 0 0 0-2 2V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-7.5a2 2 0 0 0-2-2h-1"/>
                                        <circle cx="12" cy="14" r="3.2"/>
                                        <path d="M19 1.5l.8 1.7 1.7.8-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8z"/>
                                    </svg>
                                    <span id="foto-texto">Adicionar foto (opcional)</span>
                                </label>

                                <button type="button" id="foto-remover" class="foto-remover" aria-label="Remover foto" title="Remover foto" hidden>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M18 6L6 18"/>
                                        <path d="M6 6l12 12"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="acoes-form">
                            <a href="/home" class="btn-voltar">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M19 12H5"/>
                                    <path d="M12 19l-7-7 7-7"/>
                                </svg>
                                Voltar
                            </a>

                            <button type="submit" class="btn-avancar">
                                Avançar
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="M12 5l7 7-7 7"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                </section>
            </main>
        </div>
    </div>

<script src="/js/novaConsulta.js"></script>
<script src="/js/cadastro.js"></script>
</body>
</html>
