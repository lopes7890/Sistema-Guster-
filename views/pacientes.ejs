<%- include ('partials/header.ejs') %>
<%
    /* Dados de exemplo*/
    const filtroAtual = typeof filtro !== 'undefined' ? filtro : 'todos';
    const totaisFiltro = typeof totais !== 'undefined' ? totais : { todos: 23, ageusia: 23, hipogeusia: 23 };
    const lista = typeof pacientes !== 'undefined' ? pacientes : [
        { id: 1, nome: 'José da Silva', ultimoExame: '17/08/2025' },
        { id: 2, nome: 'José da Silva', ultimoExame: '17/08/2025' },
        { id: 3, nome: 'José da Silva', ultimoExame: '17/08/2025' },
        { id: 4, nome: 'José da Silva', ultimoExame: '17/08/2025' },
        { id: 5, nome: 'José da Silva', ultimoExame: '17/08/2025' }
    ];
    const filtrosDiagnostico = [
        { chave: 'todos',      rotulo: 'Todos' },
        { chave: 'ageusia',    rotulo: 'Ageusia' },
        { chave: 'hipogeusia', rotulo: 'Hipogeusia' }
    ];
%>
    <div class="layout">
        <%- include ('partials/sidebar.ejs', { paginaAtiva: 'pacientes' }) %>

        <div class="layout-conteudo">
            <%- include ('partials/topbar.ejs') %>

            <main class="pacientes-lista">
                <!-- Busca e filtros -->
                <section class="painel painel-busca">
                    <div class="busca">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35"/>
                        </svg>
                        <input type="search" name="busca" placeholder="Buscar pacientes por nome, CPF ou prontuário clínico..." aria-label="Buscar pacientes">
                    </div>

                    <div class="filtros">
                        <select name="periodo" aria-label="Período">
                            <option value="hoje">Hoje</option>
                            <option value="ontem">Ontem</option>
                            <option value="semana">Últimos 7 dias</option>
                            <option value="todos">Todos</option>
                        </select>

                        <!-- <button type="button" class="btn-filtros">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                            </svg>
                            Filtros
                        </button> -->
                    </div>
                </section>

                <!-- Título da seção -->
                <div class="pacientes-header">
                    <div>
                        <h2>Pacientes cadastrados</h2>
                        <p>Visualizar pacientes cadastrados no sistema</p>
                    </div>

                    <a href="/pacientes/arquivados" class="link-arquivadas">
                        Visualizar Arquivados
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 18l6-6-6-6"/>
                        </svg>
                    </a>
                </div>

                <!-- Filtro por diagnóstico -->
                <nav class="chips-diagnostico" aria-label="Filtrar por diagnóstico">
                    <% filtrosDiagnostico.forEach(function (f) { %>
                    <a href="/pacientes?diagnostico=<%= f.chave %>" class="chip <%= filtroAtual === f.chave ? 'ativo' : '' %>">
                        <%= f.rotulo %> (<%= totaisFiltro[f.chave] %>)
                    </a>
                    <% }); %>
                </nav>

                <!-- Lista de pacientes -->
                <section class="grid-pacientes">
                    <% if (lista.length === 0) { %>
                    <p class="pacientes-vazio">Nenhum paciente encontrado.</p>
                    <% } %>

                    <% lista.forEach(function (p) { %>
                    <article class="card-paciente">
                        <div class="card-paciente-topo">
                            <div class="card-paciente-avatar">
                                <% if (p.foto) { %><img src="<%= p.foto %>" alt="Foto de <%= p.nome %>"><% } %>
                            </div>

                            <div class="card-paciente-dados">
                                <strong>Nome:</strong>
                                <span><%= p.nome %></span>

                                <strong class="espaco">Data do último exame:</strong>
                                <span><%= p.ultimoExame || '—' %></span>
                            </div>
                        </div>

                        <div class="card-paciente-acoes">
                            <a href="/pacientes/<%= p.id %>" class="btn-card btn-visualizar">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                Visualizar Prontuário
                            </a>

                            <form action="/pacientes/<%= p.id %>/arquivar" method="post">
                                <button type="submit" class="btn-card btn-arquivar" ;>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 6h18"/>
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                        <path d="M10 11v6"/>
                                        <path d="M14 11v6"/>
                                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                    </svg>
                                    Arquivar Prontuário
                                </button>
                            </form>
                        </div>
                    </article>
                    <% }); %>
                </section>
            </main>
        </div>
    </div>
</body>
</html>
