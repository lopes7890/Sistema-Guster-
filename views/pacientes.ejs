<%- include ('partials/header.ejs') %>
<%
    const filtroAtual = typeof filtro !== 'undefined' ? filtro : 'todos';

    const totaisFiltro = typeof contagem !== 'undefined'
        ? contagem
        : { total: 0, ageusia: 0, hipogeusia: 0 };

    const lista = pacientes;

    const filtrosDiagnostico = [
        { chave: 'todos', rotulo: 'Todos', total: totaisFiltro.total },
        { chave: 'ageusia', rotulo: 'Ageusia', total: totaisFiltro.ageusia },
        { chave: 'hipogeusia', rotulo: 'Hipogeusia', total: totaisFiltro.hipogeusia }
    ];
%>
    <div class="layout">
        <%- include ('partials/sidebar.ejs', { paginaAtiva: 'pacientes' }) %>

        <div class="layout-conteudo">
            <%- include ('partials/topbar.ejs') %>

            <main class="pacientes-lista" data-arquivados="<%= arquivados %>">
                <!-- Busca e filtros -->
                <section class="painel painel-busca">
                    <div class="busca">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35"/>
                        </svg>
                        <input type="search" name="busca" placeholder="Buscar pacientes por nome, CPF ou prontuário clínico..." aria-label="Buscar pacientes">
                    </div>

                    <div class="filtros">
                        <select name="periodo" aria-label="Período">
                            <option value="hoje">Hoje</option>
                            <option value="ontem">Ontem</option>
                            <option value="semana">Últimos 7 dias</option>
                            <option value="todos">Todos</option>
                        </select>
                    </div>
                </section>

                <!-- Título da seção + alternância -->
                <div class="pacientes-header">
                    <div>
                        <% if (arquivados) { %>
                            <h2>Pacientes Arquivados</h2>
                            <p>Visualizar pacientes arquivados no sistema</p>
                        <% } else { %>
                            <h2>Pacientes cadastrados</h2>
                            <p>Visualizar pacientes cadastrados no sistema</p>
                        <% } %>
                    </div>

                    <a href="<%= arquivados ? '/pacientes' : '/pacientes/arquivados' %>" class="link-arquivadas">
                        <%= arquivados ? 'Pacientes cadastrados' : 'Visualizar Arquivados' %>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 18l6-6-6-6"/>
                        </svg>
                    </a>
                </div>

                <!-- Filtro por diagnóstico -->
                 <% if (!arquivados) { %>
                <nav class="chips-diagnostico" aria-label="Filtrar por diagnóstico">
                    <% filtrosDiagnostico.forEach(function (f) { %>
                        <a href="/pacientes/filtrar/diagnostico?diagnostico=<%= f.chave %>&arquivados=<%= arquivados %>"
                           class="chip <%= filtroAtual === f.chave ? 'ativo' : '' %>">
                            <%= f.rotulo %> (<%= f.total %>)
                        </a>
                    <% }); %>
                </nav>
                <% } %>

                <!-- Lista de pacientes -->
                <section class="grid-pacientes">
                    <%- include('partials/cards-pacientes', { lista, arquivados }) %>
                </section>
            </main>
        </div>
    </div>
<script src="/js/pacientes.js"></script>
<%- include ('partials/footer.ejs') %>