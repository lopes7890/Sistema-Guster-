<%- include ('partials/header.ejs') %>
    <div class="layout">
        <%- include ('partials/sidebar.ejs', { paginaAtiva: 'home' }) %>

        <div class="layout-conteudo">
            <%- include ('partials/topbar.ejs') %>

            <main class="paciente-novo">
                <section class="paciente-novo-card">
                    <%- include ('partials/stepper.ejs', { etapaAtual: 3 }) %>

                    <h2 style="padding: 30px;">Conexão com o BCI</h2>

                    <div class="area-bci-wrapper">
                        <div class="area-sinal-bci">
                            <p id="texto-espera">Aguardando conexão...</p>
                                <video id="meu-video" class="meu-video" width="100%" height="100%" style="display: none;" loop muted playsinline>
                                    <source src="/videos/sinal-eeg.mp4" type="video/mp4">
                                </video>
                        </div>
                        <p id="texto-conectado" class="texto-conectado">Dispositivo conectado com Sucesso!</p>
                    </div>
                    
                    <div class="acoes-form">
                        <a href="/consulta/nova" class="btn-voltar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M19 12H5"/>
                                <path d="M12 19l-7-7 7-7"/>
                            </svg>
                            Voltar
                        </a>

                        <a href="/consulta/exameBCI/<%= id_paciente %>" class="btn-avancar">
                            Iniciar Consulta
                        </a>
                    </div>
                </section>
            </main>
        </div>
    </div>
<script src="/js/script.js"></script>
</body>
</html>