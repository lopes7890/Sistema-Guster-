<%- include ('partials/header.ejs') %>
    <main class="cadastro">
        <section class="cadastro-imagem">
            <img class="cadastro-logo" src="/imgs/Logo-Vetorizada.png" alt="Logo do sistema Guster">
        </section>

        <section class="cadastro-area">
            <form class="cadastro-form" action="/cadastro" method="post">
                <div class="row">
                    <div class="field">
                        <label for="cpf">CPF</label>
                        <input type="text" id="cpf" name="cpf" placeholder="XXX.XXX.XXX-XX" inputmode="numeric" maxlength="14" autocomplete="off" required>
                    </div>

                    <div class="field">
                        <label for="nascimento">Data de Nascimento</label>
                        <input type="date" id="nascimento" name="nascimento" autocomplete="bday" required>
                    </div>
                </div>

                <div class="field">
                    <label for="nome">Nome Completo</label>
                    <input type="text" id="nome" name="nome" placeholder="Seu nome" autocomplete="name" required>
                </div>

                <div class="row">
                    <div class="field">
                        <label for="crm">CRM</label>
                        <input type="text" id="crm" name="crm" placeholder="XXXXXXX/XX" autocomplete="off" required>
                    </div>

                    <div class="field">
                        <label for="cep">CEP</label>
                        <input type="text" id="cep" name="cep" placeholder="XX XXX-XXX" inputmode="numeric" maxlength="10" autocomplete="postal-code" required>
                    </div>
                </div>

                <div class="field">
                    <label for="endereco">Endereço</label>
                    <input type="text" id="endereco" name="endereco" placeholder="Rua, n°, Bairro - Cidade" autocomplete="street-address" required>
                </div>

                <div class="field">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" placeholder="exemplo@gmail.com" autocomplete="email" required>
                </div>

                <div class="field">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" placeholder="************" autocomplete="new-password" required>
                </div>

                <div class="field">
                    <label for="confirmar-senha">Confirmar Senha</label>
                    <input type="password" id="confirmar-senha" name="confirmarSenha" placeholder="************" autocomplete="new-password" required>
                </div>

                <button type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <path d="M10 17l5-5-5-5"/>
                        <path d="M15 12H3"/>
                    </svg>
                    Cadastrar
                </button>
                <p class="singnin">Já tem uma conta? <a href="/"><Strong>Realizar Login</Strong></a></p>
            </form>
            
        </section>
    </main>
</body>
</html>
