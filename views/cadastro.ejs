<%- include ('partials/header.ejs') %>
    <main class="cadastro">
        <section class="cadastro-imagem">
            <img class="cadastro-logo img-logo" src="/imgs/Logo-Vetorizada.png" alt="Logo do sistema Guster">
        </section>

        <section class="cadastro-area">
            <form class="cadastro-form" action="/cadastro/medico" method="post">
                <div class="row">
                    <div class="field">
                        <label for="cpf">CPF</label>
                        <input type="text" id="cpf" name="cpf" data-mascara="cpf" placeholder="XXX.XXX.XXX-XX" inputmode="numeric" maxlength="14" pattern="\d{3}\.\d{3}\.\d{3}-\d{2}" title="Formato: 000.000.000-00" autocomplete="off" required>
                    </div>

                    <div class="field">
                        <label for="nascimento">Data de Nascimento</label>
                        <input type="date" id="nascimento" name="nascimento" autocomplete="bday" required>
                    </div>
                </div>

                <div class="field">
                    <label for="nome">Nome Completo</label>
                    <input type="text" id="nome" name="nome" placeholder="Seu nome" autocomplete="name" required>
                </div>

                <div class="row">
                    <div class="field">
                        <label for="crm">CRM</label>
                        <input type="text" id="crm" name="crm" data-mascara="crm" placeholder="XXXXXX/XX" maxlength="10" pattern="\d{4,7}/[A-Z]{2}" title="Formato: 123456/SP" autocomplete="off" required>
                    </div>

                    <div class="field">
                        <label for="cep">CEP</label>
                        <input type="text" id="cep" name="cep" data-mascara="cep" placeholder="XXXXX-XXX" inputmode="numeric" maxlength="9" pattern="\d{5}-\d{3}" title="Formato: 00000-000" autocomplete="postal-code" required>
                    </div>
                </div>

                <div class="field">
                    <label for="endereco">Endereço</label>
                    <input type="text" id="endereco" name="endereco" placeholder="Rua, n°, Bairro - Cidade" autocomplete="street-address" required>
                </div>

                <div class="field">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" placeholder="exemplo@gmail.com" autocomplete="email" required>
                </div>

                <div class="campo-senha">
                    <div class="field">
                        <label for="senha">Senha</label>
                        <input type="password" id="senha" name="senha" placeholder="************" required>

                        <button type="button" class="btn-olho" data-alternar-senha="senha" aria-label="Mostrar senha" aria-pressed="false">
                            <svg class="icone-visivel" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="icone-escondido" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <path d="M1 1l22 22"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="campo-senha">
                    <div class="field">
                        <label for="confirma-senha">Confirmar Senha</label>
                        <input type="password" id="confirma-senha" name="confirmar-senha" placeholder="************" required>

                        <button type="button" class="btn-olho" data-alternar-senha="confirma-senha" aria-label="Mostrar senha" aria-pressed="false">
                            <svg class="icone-visivel" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="icone-escondido" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <path d="M1 1l22 22"/>
                            </svg>
                        </button>
                    </div>
                </div>
<!-- 
                <div class="field">
                    <label for="confirmar-senha">Confirmar Senha</label>
                    <input type="password" id="confirmar-senha" name="confirmarSenha" placeholder="************" autocomplete="new-password" required>
                </div> -->

                <button type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <path d="M10 17l5-5-5-5"/>
                        <path d="M15 12H3"/>
                    </svg>
                    Cadastrar
                </button>
                <p class="singnin">Já tem uma conta? <a href="/"><Strong>Realizar Login</Strong></a></p>
            </form>
            
        </section>
    </main>

<script src="/js/cadastro.js"></script>
<script src="/js/mostrarSenha.js"></script>
</body>
</html>
