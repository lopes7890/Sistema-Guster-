<%- include ('partials/header.ejs') %>
    <div class="layout">
        <%- include ('partials/sidebar.ejs', { paginaAtiva: 'home' }) %>

        <div class="layout-conteudo">
            <%- include ('partials/topbar.ejs') %>

            <main class="paciente-novo">
                <section class="paciente-novo-card">
                    <h2>Informações para consultas</h2>

                    <%- include ('partials/stepper.ejs', { etapaAtual: 2 }) %>

                    <form class="form-paciente" action="/consulta/informacoes" method="post">
                        <div class="campos campos-info">
                            <div class="linha linha-info">
                                <div class="field">
                                    <label for="data-covid">Data em que teve COVID-19</label>
                                    <input type="date" id="data-covid" name="dataCovid" required>
                                </div>

                                <div class="field">
                                    <label for="capacidade-sabor">De 0 a 10, qual sua capacidade de perceber sabores?</label>
                                    <input type="number" id="capacidade-sabor" name="capacidadeSabor" placeholder="0 - Não sinto / 10 - Sinto claramente" min="0" max="10" step="1" required>
                                </div>
                            </div>

                            <div class="field field-medio">
                                <label for="diferenca-paladar">O paciente sentiu diferenças no paladar no período da infecção?</label>
                                <select id="diferenca-paladar" name="diferencaPaladar" required>
                                    <option value="" disabled selected hidden>Sim / Não</option>
                                    <option value="sim">Sim</option>
                                    <option value="nao">Não</option>
                                </select>
                            </div>

                            <div class="field field-medio">
                                <label for="primeira-percepcao">Quando percebeu essa alteração pela primeira vez?</label>
                                <input type="text" id="primeira-percepcao" name="primeiraPercepcao" placeholder="Em dia tal, quando fui comer tal coisa..." autocomplete="off" required>
                            </div>

                            <div class="field field-medio">
                                <label for="alteracao-covid">A alteração começou durante a COVID-19 ou depois?</label>
                                <select id="alteracao-covid" name="alteracaoCovid" required>
                                    <option value="" disabled selected hidden>Durante / Depois</option>
                                    <option value="Durante">Durante</option>
                                    <option value="Depois">Depois</option>
                                </select>
                            </div>
                            <input type="hidden" name="id_paciente" value="<%= id_paciente %>">
                        </div>

                        <div class="acoes-form">
                            <a href="/consulta/nova" class="btn-voltar">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M19 12H5"/>
                                    <path d="M12 19l-7-7 7-7"/>
                                </svg>
                                Voltar
                            </a>

                            <button type="submit" class="btn-avancar">
                                Avançar
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"/>
                                    <path d="M12 5l7 7-7 7"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                </section>
            </main>
        </div>
    </div>
</body>
</html>
